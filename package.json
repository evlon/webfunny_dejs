{
  "name": "webfunny_dejs",
  "version": "1.0.0",
  "description": "JavaScript dependency analysis and deobfuscation tool",
  "main": "de.js",
  "scripts": {
    "test": "node tests/utils/test-runner.js",
    "test:unit": "node tests/utils/test-runner.js unit",
    "test:integration": "node tests/utils/test-runner.js integration",
    "test:functional": "node tests/utils/test-runner.js functional",
    "test:regression": "node tests/utils/test-runner.js regression",
    "test:coverage": "npx jest --coverage",
    "test:verbose": "node tests/utils/test-runner.js --verbose"
  },
  "keywords": [
    "javascript",
    "dependency",
    "analysis",
    "deobfuscation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "atob": "^2.1.2",
    "commander": "^14.0.2",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "vm": "^0.1.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "de.js"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@babel|yargs/build)/)"
    ],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    }
  }
}
